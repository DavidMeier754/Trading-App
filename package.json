{
  "name": "trading-app",
  "version": "1.0.0",
  "main": "index.ts",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "build:web": "expo export --platform web --output-dir dist",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "TZ=UTC jest && node jest/zones.js",
    "gen:content": "node tools/gen_content.mjs",
    "smoke": "node tools/smoke.mjs",
    "check:ui": "node tools/check_ui.mjs",
    "sheets": "node tools/contact_sheets.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavidMeier754/Trading-App.git"
  },
  "author": "",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/DavidMeier754/Trading-App/issues"
  },
  "homepage": "https://github.com/DavidMeier754/Trading-App#readme",
  "dependencies": {
    "@expo-google-fonts/archivo": "^0.4.2",
    "@expo/metro-runtime": "~57.0.16",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "^57.0.24",
    "expo-audio": "~57.0.5",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "lucide-react-native": "1.47.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/jest": "^29.5.14",
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.5",
    "js-yaml": "^5.4.2",
    "playwright": "^1.56.1",
    "prettier": "^3.9.9",
    "typescript": "~5.9"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest/setup.js"
    ],
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "yaml",
      "yml"
    ],
    "transform": {
      "\\.ya?ml$": "<rootDir>/jest/yaml-transform.js"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/",
      "/.claude/",
      "/.agents/"
    ],
    "moduleNameMapper": {
      "^lucide-react-native/icons/(.*)$": "<rootDir>/node_modules/lucide-react-native/dist/cjs/icons/$1.js",
      "^lucide-react-native$": "<rootDir>/node_modules/lucide-react-native/dist/cjs/lucide-react-native.js"
    }
  }
}
